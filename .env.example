# MeetTranscribe Environment Variables

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Whisper Configuration
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_LANGUAGE=

# Diarization Configuration
DIARIZATION_DEVICE=cuda

# Speaker Recognition
SPEAKER_RECOGNITION_DEVICE=cuda
SIMILARITY_THRESHOLD=0.85

# Storage
DATABASE_URL=sqlite:///data/meettranscribe.db
REDIS_URL=

# HuggingFace (required for pyannote.audio)
HUGGINGFACE_TOKEN=your_token_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
